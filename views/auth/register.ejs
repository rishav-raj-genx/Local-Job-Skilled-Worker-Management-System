<%- include('../partials/header', { title: 'Register - Skilled Worker Hub' }) %>

<div style="max-width: 650px; margin: 2rem auto;">
  <div class="card" style="box-shadow: var(--shadow-lg);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Create Your Account</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Join as a customer looking for services or as a skilled trade professional</p>
    </div>

    <form action="/auth/register" method="POST" id="registerForm">
      <!-- Role Selection Tabs -->
      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label class="form-label">I want to join as a:</label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          <label style="border: 2px solid var(--border-color); padding: 0.85rem; border-radius: var(--radius-sm); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" id="roleCustomerLabel">
            <input type="radio" name="role" value="customer" <%= (typeof role === 'undefined' || role === 'customer') ? 'checked' : '' %> onchange="toggleRoleFields('customer')">
            <div>
              <strong style="display: block; font-size: 0.95rem;">Customer</strong>
              <small style="color: var(--text-muted); font-size: 0.775rem;">Hire skilled workers</small>
            </div>
          </label>
          <label style="border: 2px solid var(--border-color); padding: 0.85rem; border-radius: var(--radius-sm); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" id="roleWorkerLabel">
            <input type="radio" name="role" value="worker" <%= (typeof role !== 'undefined' && role === 'worker') ? 'checked' : '' %> onchange="toggleRoleFields('worker')">
            <div>
              <strong style="display: block; font-size: 0.95rem;">Skilled Worker</strong>
              <small style="color: var(--text-muted); font-size: 0.775rem;">Offer trade services</small>
            </div>
          </label>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="name" class="form-label">Full Name *</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control" 
            required 
            placeholder="e.g. Ramesh Kumar"
            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
          >
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email Address *</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control" 
            required 
            placeholder="ramesh@example.com"
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
          >
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="phone" class="form-label">Phone Number</label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-control" 
            placeholder="+91 98765 43210"
            value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
          >
        </div>

        <div class="form-group">
          <label for="location" class="form-label">City / Primary Area *</label>
          <input 
            type="text" 
            id="location" 
            name="location" 
            class="form-control" 
            required 
            placeholder="e.g. New Delhi, South Ext"
            value="<%= typeof formData !== 'undefined' && formData.location ? formData.location : 'New Delhi' %>"
          >
        </div>
      </div>

      <!-- Worker Specific Fields (conditionally shown) -->
      <div id="workerFields" style="display: <%= (typeof role !== 'undefined' && role === 'worker') ? 'block' : 'none' %>; background: #f8fafc; padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 1.25rem;">
        <h4 style="font-size: 1rem; margin-bottom: 0.85rem; color: var(--primary);">Worker Profile Details</h4>

        <div class="form-group">
          <label for="skills" class="form-label">Trade Skills (comma separated) *</label>
          <input 
            type="text" 
            id="skills" 
            name="skills" 
            class="form-control" 
            placeholder="e.g. Electrician, AC Repair, Plumber"
            value="<%= typeof formData !== 'undefined' && formData.skills ? formData.skills : '' %>"
          >
          <p class="form-hint">Enter your primary skills so customers can discover you in search results.</p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label for="experience" class="form-label">Years of Experience</label>
            <input 
              type="number" 
              id="experience" 
              name="experience" 
              class="form-control" 
              min="0" 
              placeholder="e.g. 5"
              value="<%= typeof formData !== 'undefined' && formData.experience ? formData.experience : '3' %>"
            >
          </div>

          <div class="form-group">
            <label for="serviceArea" class="form-label">Service Area Coverage</label>
            <input 
              type="text" 
              id="serviceArea" 
              name="serviceArea" 
              class="form-control" 
              placeholder="e.g. Delhi NCR, Noida, Ghaziabad"
              value="<%= typeof formData !== 'undefined' && formData.serviceArea ? formData.serviceArea : '' %>"
            >
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label for="bio" class="form-label">Short Professional Bio</label>
          <textarea 
            id="bio" 
            name="bio" 
            class="form-control" 
            rows="2" 
            placeholder="Briefly describe your expertise, certifications, and availability..."
          ><%= typeof formData !== 'undefined' && formData.bio ? formData.bio : '' %></textarea>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="password" class="form-label">Password * (min 6 chars)</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            required 
            placeholder="••••••••"
            minlength="6"
          >
        </div>

        <div class="form-group">
          <label for="confirmPassword" class="form-label">Confirm Password *</label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            class="form-control" 
            required 
            placeholder="••••••••"
            minlength="6"
          >
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Complete Registration
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.9rem;">
      <span style="color: var(--text-muted);">Already registered?</span>
      <a href="/auth/login" style="font-weight: 600; margin-left: 0.35rem;">Log In</a>
    </div>
  </div>
</div>

<script>
  function toggleRoleFields(role) {
    const workerFields = document.getElementById('workerFields');
    const custLabel = document.getElementById('roleCustomerLabel');
    const workerLabel = document.getElementById('roleWorkerLabel');

    if (role === 'worker') {
      workerFields.style.display = 'block';
      workerLabel.style.borderColor = 'var(--primary)';
      custLabel.style.borderColor = 'var(--border-color)';
    } else {
      workerFields.style.display = 'none';
      custLabel.style.borderColor = 'var(--primary)';
      workerLabel.style.borderColor = 'var(--border-color)';
    }
  }

  // Set initial border highlight
  const selectedRole = document.querySelector('input[name="role"]:checked')?.value || 'customer';
  toggleRoleFields(selectedRole);
</script>

<%- include('../partials/footer') %>
