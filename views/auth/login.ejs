<%- include('../partials/header', { title: 'Log In - Skilled Worker Hub' }) %>

<div style="max-width: 480px; margin: 2rem auto;">
  <div class="card" style="box-shadow: var(--shadow-lg);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Welcome Back</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Sign in to access your jobs, requests, or management dashboard</p>
    </div>

    <!-- Demo Credentials Quick Fill Bar for Hackathon Judges -->
    <div style="background: #f8fafc; border: 1px dashed var(--border-color); border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 1.5rem;">
      <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">
        ⚡ Hackathon Evaluator Quick-Login:
      </span>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        <button type="button" class="btn btn-outline btn-sm" onclick="fillCredentials('admin', '123456')">
          Admin
        </button>
        <button type="button" class="btn btn-outline btn-sm" onclick="fillCredentials('rajesh.electrician@workerhub.com', 'Worker@123')">
          Worker
        </button>
        <button type="button" class="btn btn-outline btn-sm" onclick="fillCredentials('amit.sharma@gmail.com', 'Customer@123')">
          Customer
        </button>
      </div>
    </div>

    <form action="/auth/login" method="POST">
      <% if (typeof redirect !== 'undefined' && redirect) { %>
        <input type="hidden" name="redirect" value="<%= redirect %>">
      <% } %>

      <div class="form-group">
        <label for="email" class="form-label">Email Address or Admin Username</label>
        <input 
          type="text" 
          id="email" 
          name="email" 
          class="form-control" 
          required 
          placeholder="name@example.com or admin"
          autocomplete="username"
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="form-control" 
          required 
          placeholder="••••••••"
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Log In
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.9rem;">
      <span style="color: var(--text-muted);">Don't have an account yet?</span>
      <a href="/auth/register" style="font-weight: 600; margin-left: 0.35rem;">Create Account</a>
    </div>
  </div>
</div>

<script>
  function fillCredentials(email, pass) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = pass;
  }
</script>

<%- include('../partials/footer') %>
