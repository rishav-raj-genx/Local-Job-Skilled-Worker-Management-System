<%- include('../partials/header', { title: 'Worker Dashboard - Skilled Worker Hub' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Worker Dashboard</h1>
    <p class="page-subtitle">Welcome back, <%= worker.name %>! Manage your service requests and work status</p>
  </div>
  <div style="display: flex; gap: 0.5rem; align-items: center;">
    <% if (worker.verificationStatus === 'Verified') { %>
      <span class="badge badge-verified">✓ Verified Account</span>
    <% } else { %>
      <span class="badge badge-unverified">Verification <%= worker.verificationStatus %></span>
    <% } %>
    <a href="/worker/profile" class="btn btn-outline btn-sm">Edit Profile</a>
  </div>
</div>

<!-- Metrics Cards -->
<div class="metrics-grid">
  <div class="metric-card">
    <div class="metric-icon amber">📥</div>
    <div class="metric-info">
      <h3><%= pendingRequests %></h3>
      <p>Pending Requests</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon sky">🤝</div>
    <div class="metric-info">
      <h3><%= acceptedJobs %></h3>
      <p>Accepted Jobs</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon indigo">⚡</div>
    <div class="metric-info">
      <h3><%= inProgressJobs %></h3>
      <p>In Progress</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon emerald">✓</div>
    <div class="metric-info">
      <h3><%= completedJobs %></h3>
      <p>Jobs Completed</p>
    </div>
  </div>
</div>

<!-- Rating Summary Banner -->
<div class="card" style="margin-bottom: 2rem; background: linear-gradient(to right, #ffffff, #f8fafc);">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h3 style="font-size: 1.15rem; margin-bottom: 0.25rem;">Your Service Performance</h3>
      <p style="font-size: 0.85rem; color: var(--text-muted);">
        Calculated dynamically from verified customer reviews upon job completion
      </p>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="text-align: right;">
        <div style="font-size: 2rem; font-weight: 800; color: var(--primary); line-height: 1;">
          <%= worker.averageRating > 0 ? worker.averageRating.toFixed(1) : '0.0' %>
        </div>
        <span style="font-size: 0.775rem; color: var(--text-muted);"><%= worker.totalRatings %> total review<%= worker.totalRatings === 1 ? '' : 's' %></span>
      </div>
      <%- include('../partials/starRating', { rating: worker.averageRating }) %>
    </div>
  </div>
</div>

<!-- Incoming Requests (Immediate Attention) -->
<div class="card" style="margin-bottom: 2rem;">
  <div class="card-header">
    <div>
      <h3 class="card-title">Recent Service Requests</h3>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">Requests requiring your response or status progression</p>
    </div>
    <a href="/worker/requests" style="font-size: 0.85rem; font-weight: 600;">View All Jobs &rarr;</a>
  </div>

  <% if (recentRequests && recentRequests.length > 0) { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Customer</th>
            <th>Service</th>
            <th>Location</th>
            <th>Scheduled For</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% recentRequests.forEach(req => { %>
            <tr>
              <td>
                <strong><%= req.customer ? req.customer.name : 'Customer' %></strong>
                <div style="font-size: 0.775rem; color: var(--text-muted);"><%= req.customer ? req.customer.phone : '' %></div>
              </td>
              <td>
                <strong style="color: var(--primary);"><%= req.service %></strong>
                <div style="font-size: 0.775rem; color: var(--text-muted); max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= req.description %>
                </div>
              </td>
              <td>📍 <%= req.location %></td>
              <td>
                <%= new Date(req.preferredDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                <div style="font-size: 0.775rem; color: var(--text-muted);"><%= req.preferredTime %></div>
              </td>
              <td>
                <%- include('../partials/statusBadge', { status: req.status }) %>
              </td>
              <td>
                <% if (req.status === 'Pending') { %>
                  <div style="display: flex; gap: 0.35rem;">
                    <form action="/worker/requests/<%= req._id %>/status" method="POST" style="display: inline;">
                      <input type="hidden" name="status" value="Accepted">
                      <button type="submit" class="btn btn-success btn-sm">Accept</button>
                    </form>
                    <form action="/worker/requests/<%= req._id %>/status" method="POST" style="display: inline;" data-confirm="Are you sure you want to decline this job request?">
                      <input type="hidden" name="status" value="Rejected">
                      <button type="submit" class="btn btn-danger btn-sm">Decline</button>
                    </form>
                  </div>
                <% } else if (req.status === 'Accepted') { %>
                  <form action="/worker/requests/<%= req._id %>/status" method="POST" style="display: inline;">
                    <input type="hidden" name="status" value="In Progress">
                    <button type="submit" class="btn btn-primary btn-sm">Start Job</button>
                  </form>
                <% } else if (req.status === 'In Progress') { %>
                  <form action="/worker/requests/<%= req._id %>/status" method="POST" style="display: inline;" data-confirm="Mark this job as completed?">
                    <input type="hidden" name="status" value="Completed">
                    <button type="submit" class="btn btn-success btn-sm">Complete</button>
                  </form>
                <% } else { %>
                  <a href="/worker/requests" class="btn btn-outline btn-sm">View</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">👷</div>
      <h3 class="empty-title">No Requests Yet</h3>
      <p class="empty-desc">When local customers book your trade services, incoming requests will appear here.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
