<%- include('../partials/header', { title: 'Admin Master Hub - Skilled Worker Platform' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Admin Master Dashboard</h1>
    <p class="page-subtitle">Real-time system telemetry, service demand analytics, and platform oversight</p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/admin/workers" class="btn btn-primary btn-sm">
      Verify Workers (<%= stats.pendingVerifications %>)
    </a>
    <a href="/admin/complaints" class="btn btn-outline btn-sm">
      Complaints (<%= stats.openComplaints %>)
    </a>
  </div>
</div>

<!-- Primary Platform Metrics -->
<div class="metrics-grid">
  <div class="metric-card">
    <div class="metric-icon indigo">👥</div>
    <div class="metric-info">
      <h3><%= stats.totalUsers %></h3>
      <p>Total Users (<%= stats.totalCustomers %> Cust / <%= stats.totalWorkers %> Work)</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon amber">⏳</div>
    <div class="metric-info">
      <h3><%= stats.pendingVerifications %></h3>
      <p>Pending Verifications</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon sky">⚡</div>
    <div class="metric-info">
      <h3><%= stats.activeJobs %></h3>
      <p>Active Service Jobs</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon emerald">✓</div>
    <div class="metric-info">
      <h3><%= stats.completedJobs %></h3>
      <p>Completed Jobs</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon rose">⚠️</div>
    <div class="metric-info">
      <h3><%= stats.openComplaints %></h3>
      <p>Open Complaints</p>
    </div>
  </div>
  <div class="metric-card">
    <div class="metric-icon indigo">★</div>
    <div class="metric-info">
      <h3><%= (stats.ratingSummary && stats.ratingSummary.average) ? stats.ratingSummary.average.toFixed(1) : '0.0' %></h3>
      <p>Platform Satisfaction Rating</p>
    </div>
  </div>
</div>

<!-- Analytics Grid: Most Requested Services & Rating Distribution -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
  <!-- Most-Requested Services (Calculated via MongoDB Aggregation) -->
  <div class="card">
    <div class="card-header">
      <div>
        <h3 class="card-title">Most-Requested Services</h3>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
          Aggregated dynamically from actual MongoDB service requests
        </p>
      </div>
      <span class="badge badge-accepted">Live Aggregation</span>
    </div>

    <% if (stats.mostRequestedServices && stats.mostRequestedServices.length > 0) { %>
      <% 
        const maxCount = Math.max(...stats.mostRequestedServices.map(s => s.count), 1);
      %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% stats.mostRequestedServices.forEach(item => { %>
          <div>
            <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.35rem;">
              <strong style="color: var(--text-main);"><%= item._id || 'General Repair' %></strong>
              <span style="font-weight: 700; color: var(--primary);"><%= item.count %> request<%= item.count === 1 ? '' : 's' %></span>
            </div>
            <div style="width: 100%; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden;">
              <div style="width: <%= Math.round((item.count / maxCount) * 100) %>%; height: 100%; background: linear-gradient(90deg, var(--primary), var(--secondary)); border-radius: 4px;"></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state" style="padding: 2rem;">
        <p style="color: var(--text-muted); font-size: 0.85rem;">No service request data recorded yet.</p>
      </div>
    <% } %>
  </div>

  <!-- Rating Statistics Breakdown (MongoDB Aggregation) -->
  <div class="card">
    <div class="card-header">
      <div>
        <h3 class="card-title">Platform Rating Distribution</h3>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
          Based on <%= stats.ratingSummary.total || 0 %> verified customer rating reviews
        </p>
      </div>
      <div style="text-align: right;">
        <span style="font-size: 1.5rem; font-weight: 800; color: #f59e0b;">★ <%= (stats.ratingSummary && stats.ratingSummary.average) ? stats.ratingSummary.average.toFixed(1) : '0.0' %></span>
      </div>
    </div>

    <% const total = stats.ratingSummary.total || 1; %>
    <div style="display: flex; flex-direction: column; gap: 0.65rem;">
      <% [5, 4, 3, 2, 1].forEach(star => { %>
        <% 
          let starCount = 0;
          if (star === 5) starCount = stats.ratingSummary.fiveStar || 0;
          if (star === 4) starCount = stats.ratingSummary.fourStar || 0;
          if (star === 3) starCount = stats.ratingSummary.threeStar || 0;
          if (star === 2) starCount = stats.ratingSummary.twoStar || 0;
          if (star === 1) starCount = stats.ratingSummary.oneStar || 0;
          const pct = Math.round((starCount / total) * 100);
        %>
        <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem;">
          <span style="width: 50px; font-weight: 600;"><%= star %> Star</span>
          <div style="flex: 1; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden;">
            <div style="width: <%= pct %>%; height: 100%; background: #f59e0b; border-radius: 4px;"></div>
          </div>
          <span style="width: 35px; text-align: right; color: var(--text-muted); font-size: 0.75rem;"><%= starCount %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Quick Administration Navigation -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
  <a href="/admin/workers" class="card" style="text-decoration: none; color: inherit;">
    <h4 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--primary);">Worker Profile Verification &rarr;</h4>
    <p style="font-size: 0.85rem; color: var(--text-muted);">
      Review unverified workers, inspect skills and experience, and approve/reject credentials.
    </p>
  </a>

  <a href="/admin/users" class="card" style="text-decoration: none; color: inherit;">
    <h4 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--primary);">User Account Management &rarr;</h4>
    <p style="font-size: 0.85rem; color: var(--text-muted);">
      Inspect all customer and worker accounts, search users, and toggle active status.
    </p>
  </a>

  <a href="/admin/complaints" class="card" style="text-decoration: none; color: inherit;">
    <h4 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--primary);">Complaint Monitoring & Resolution &rarr;</h4>
    <p style="font-size: 0.85rem; color: var(--text-muted);">
      Investigate reported service issues, record administrative findings, and close tickets.
    </p>
  </a>
</div>

<%- include('../partials/footer') %>
