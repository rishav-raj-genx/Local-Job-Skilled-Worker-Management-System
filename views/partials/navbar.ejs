<nav class="site-navbar">
  <div class="container navbar-inner">
    <a href="/" class="brand-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
      <span>WorkerHub</span>
      <span class="brand-badge">PS 7</span>
    </a>

    <ul class="nav-links">
      <% if (!currentUser) { %>
        <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
        <li><a href="/workers" class="nav-link <%= currentPath === '/workers' ? 'active' : '' %>">Find Workers</a></li>
        <li><a href="/auth/login" class="nav-link <%= currentPath === '/auth/login' ? 'active' : '' %>">Log In</a></li>
        <li><a href="/auth/register" class="btn btn-primary btn-sm">Get Started</a></li>
      <% } else if (currentUser.role === 'customer') { %>
        <li><a href="/customer/dashboard" class="nav-link <%= currentPath === '/customer/dashboard' ? 'active' : '' %>">Dashboard</a></li>
        <li><a href="/customer/search" class="nav-link <%= currentPath.startsWith('/customer/search') ? 'active' : '' %>">Find Workers</a></li>
        <li><a href="/customer/requests" class="nav-link <%= currentPath.startsWith('/customer/requests') ? 'active' : '' %>">My Requests</a></li>
      <% } else if (currentUser.role === 'worker') { %>
        <li><a href="/worker/dashboard" class="nav-link <%= currentPath === '/worker/dashboard' ? 'active' : '' %>">Dashboard</a></li>
        <li><a href="/worker/requests" class="nav-link <%= currentPath.startsWith('/worker/requests') ? 'active' : '' %>">Job Requests</a></li>
        <li><a href="/worker/skills" class="nav-link <%= currentPath === '/worker/skills' ? 'active' : '' %>">My Skills</a></li>
        <li><a href="/worker/profile" class="nav-link <%= currentPath === '/worker/profile' ? 'active' : '' %>">Profile</a></li>
      <% } else if (currentUser.role === 'admin') { %>
        <li><a href="/admin/dashboard" class="nav-link <%= currentPath === '/admin/dashboard' ? 'active' : '' %>">Admin Hub</a></li>
        <li><a href="/admin/workers" class="nav-link <%= currentPath.startsWith('/admin/workers') ? 'active' : '' %>">Verifications</a></li>
        <li><a href="/admin/users" class="nav-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">Users</a></li>
        <li><a href="/admin/complaints" class="nav-link <%= currentPath.startsWith('/admin/complaints') ? 'active' : '' %>">Complaints</a></li>
      <% } %>

      <% if (currentUser) { %>
        <li style="display: flex; align-items: center; gap: 0.75rem; margin-left: 0.5rem;">
          <div class="user-badge">
            <span class="role-tag <%= currentUser.role %>"><%= currentUser.role %></span>
            <span><%= currentUser.name.split(' ')[0] %></span>
          </div>
          <a href="/auth/logout" class="btn btn-outline btn-sm" title="Log out of system">Log Out</a>
        </li>
      <% } %>
    </ul>
  </div>
</nav>
