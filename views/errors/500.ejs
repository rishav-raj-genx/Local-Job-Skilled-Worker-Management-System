<%- include('../partials/header', { title: '500 - Server Error' }) %>

<div style="max-width: 600px; margin: 4rem auto; text-align: center;">
  <div class="card" style="padding: 3rem 2rem; box-shadow: var(--shadow-lg);">
    <div style="font-size: 3.5rem; color: var(--danger); margin-bottom: 1rem;">⚠️</div>
    <h1 style="font-size: 2rem; margin-bottom: 0.75rem;">Server Error (500)</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 2rem; line-height: 1.6;">
      <%= typeof message !== 'undefined' ? message : 'An unexpected server error occurred.' %>
    </p>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <div style="text-align: left; background: #0f172a; color: #f87171; padding: 1rem; border-radius: var(--radius-sm); font-size: 0.75rem; overflow-x: auto; margin-bottom: 1.5rem;">
        <pre><%= stack %></pre>
      </div>
    <% } %>

    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/" class="btn btn-primary">Return to Homepage</a>
      <a href="javascript:location.reload()" class="btn btn-outline">Retry Page</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
